@page
@model SpaFlow.Web.Pages.Services.IndexModel
@{
    ViewData["Title"] = "Servicios";
}
<div class="page-heading"><div><span class="eyebrow">CATÁLOGO</span><h1>Servicios</h1></div></div>
<section class="card"><div class="table-wrap"><table><thead><tr><th>Servicio</th><th>Categoría</th><th>Duración</th><th>Precio</th><th>Comisión</th></tr></thead><tbody>
@foreach(var s in Model.Services){<tr><td><strong>@s.Name</strong><br/><small>@s.Description</small></td><td>@s.Category.Name</td><td>@s.DurationMinutes min</td><td>Bs @s.Price.ToString("N2")</td><td>@s.DefaultCommissionPercent%</td></tr>}
</tbody></table></div></section>
