@page
@model SpaFlow.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Inicio";
}
<div class="landing">
    <section class="landing-card">
        <span class="eyebrow">SPA MANAGEMENT</span>
        <h1>Gestiona reservas, clientes, servicios, equipo e inventario desde un solo lugar.</h1>
        <p>SpaFlow es una base comercial en ASP.NET Core Razor Pages para administrar un spa o centro de bienestar.</p>
        <div class="actions">
            <a class="btn primary" asp-area="Identity" asp-page="/Account/Login">Ingresar al sistema</a>
        </div>
    </section>
</div>
