@page
@model SpaFlow.Web.Pages.Settings.IndexModel
@{ ViewData["Title"] = "Configuración"; }
<div class="page-heading"><div><span class="eyebrow">ADMINISTRACIÓN</span><h1>Configuración del SPA</h1></div></div>
<section class="card form-card"><form method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><label>Nombre<input asp-for="Business.Name"/></label><label>Razón social<input asp-for="Business.LegalName"/></label><label>Teléfono<input asp-for="Business.Phone"/></label><label>Correo<input asp-for="Business.Email"/></label><label>Moneda<input asp-for="Business.Currency"/></label><label>Zona horaria<input asp-for="Business.TimeZoneId"/></label></div><label>Dirección<textarea asp-for="Business.Address" rows="2"></textarea></label><button class="btn primary" type="submit">Guardar cambios</button></form></section>
